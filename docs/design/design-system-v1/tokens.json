    "cyanCandidate": {
      "status": "候选对照稿，不承诺（DQ8 C）。未经真人测试不得进入工程。",
      "paper": "#161C28", "sheet": "#1B2231", "field": "#263044", "line": "#2B3446", "frame": "#8A7444", "guide": "#2E3850",
      "ink1": "#E2DCCB", "ink2": "#B9B6AC", "ink3": "#9A9A94", "ink4": "#626A78",
      "hand": "#CFB37A", "ref": "#AEB4BE", "under": "#5E6676", "zhu": "#E5684C", "seal": "#B84A34", "danzhu": "#9C5A4A"
    },
    "roles": {
      "paper": "页面底。纸负责秩序。",
      "sheet": "笺：书写格、对照卡、字帖、图片。对纸只有 1.08，不是卡片，边界靠 frame。",
      "field": "凹：输入框、分段控件、按下底；必须有面时的分组面（浅 1.18 / 深 1.26）。",
      "elev": "弹层面。",
      "line": "0.5pt 分隔线（装饰）。",
      "frame": "格框，按控件边界算（≥ 3:1）。",
      "guide": "格内十字虚线、字帖格间线（参照层）。",
      "ink1": "字、标题、正文、主按钮底、选中、今天。",
      "ink2": "次文字、文字按钮、拼音。",
      "ink3": "辅助说明、标签、日期。",
      "ink4": "禁用、chevron、次按钮边。不用于需要阅读的文字。",
      "hand": "本人笔迹。",
      "ref": "参考字形（印刷墨）。",
      "under": "答案衬底、没有本人墨的字格。",
      "zhu": "只用于写错的朱点。一屏朱色（含印）不超过两处。",
      "seal": "只用于落款与品牌的印章。",
      "danzhu": "提示笔画、描一遍的当前笔；与朱在明度上分开（D49 ⑤：自选未写的双钩改用 ink4，朱色只表示写错）。",
      "toast": "L4 浮条（撤销条、失败提示条、Toast）：toastBg = elev（浮起的浅面，不是实心深色）、toastLine = line（1pt 细边）、toastFg = ink1、toastAct = ink1（操作是 500 字重的文字按钮，不加下划线），外加 shadow.*.toast 轻阴影、radius.container 圆角。实心深色填充只给每屏唯一的主按钮（D71 ③）。",
      "wall": "字墙四档新旧：一周内 / 一月内 / 三月内 / 更久（相当于 1 / .82 / .68 / .55 不透明度）。"
    },
    "contrast": {
      "light": { "ink1/paper": 13.92, "ink2/paper": 7.12, "ink3/paper": 4.99, "ink3/sheet": 5.39, "btnFg/btnBg": 13.92, "toastFg/toastBg": 15.03, "toastBg/btnBg": 15.03, "ink4/paper": 3.21, "hand/sheet": 15.75, "ref/sheet": 8.61, "under/sheet": 3.24, "danzhu/sheet": 3.56, "danzhu/hand": 4.43, "zhu/paper": 5.27, "zhu/sheet": 5.69, "onSeal/seal": 5.69, "frame/sheet": 3.49, "frame/paper": 3.23, "wall4/paper": 3.52, "field/paper": 1.18 },
      "dark": { "ink1/paper": 14.01, "ink2/paper": 9.02, "ink3/paper": 6.08, "ink3/sheet": 5.57, "btnFg/btnBg": 12.6, "toastFg/toastBg": 12.02, "toastBg/btnBg": 10.84, "ink4/paper": 3.18, "hand/sheet": 11.71, "ref/sheet": 7.39, "under/sheet": 3.34, "danzhu/sheet": 3.54, "danzhu/hand": 3.30, "zhu/paper": 5.76, "zhu/sheet": 5.28, "onSeal/seal": 3.74, "frame/sheet": 3.31, "frame/paper": 3.62, "wall4/paper": 4.72, "field/paper": 1.26 },
      "thresholds": { "text": 4.5, "largeTextAndGraphics": 3, "hintAndTrace": 3, "hintVsHand": 3, "toastVsPrimary": 3, "groupSurfaceLight": 1.15, "groupSurfaceDark": 1.25 },
      "knownExceptions": "ink3 在 field 上只有 4.2:1（浅色），输入框占位文字改用 ink2；line 与 guide 是装饰 / 参照层，不要求 3:1。"
    }
  },

  "typography": {
    "family": {
      "kai": ["ShiziKai", "LXGW WenKai GB", "Kaiti SC", "STKaiti", "KaiTi", "serif"],
      "song": ["ShiziSerifSC", "Noto Serif SC", "Songti SC", "STSong", "serif"],
      "hei": ["-apple-system", "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", "Microsoft YaHei", "sans-serif"]
    },
    "roles": {
      "kai": "只用于「字」本身。练习字一律用 hanzi-writer 轮廓渲染；ShiziKai 只是轮廓缺失时的回退。",
      "song": "标题、大数字、落款、题记。",
      "hei": "一切操作与说明、拼音、统计数字。"
    },
    "scale": [
      { "level": 34, "size": 34, "lineHeight": 42, "family": "song", "weight": 400, "use": "大数字" },
      { "level": 28, "size": 28, "lineHeight": 36, "family": "song", "weight": 500, "use": "页面大标题、结果页标题" },
      { "level": 22, "size": 22, "lineHeight": 30, "family": "song", "weight": 500, "use": "节标题" },
      { "level": 17, "size": 17, "lineHeight": 26, "lineHeightSingle": 22, "family": "hei", "weight": [400, 500], "use": "正文、列表主文字；按钮与页头标题 500" },
      { "level": 15, "size": 15, "lineHeight": 22, "family": "hei", "weight": 400, "use": "说明句、列表次文字、题面拼音、Toast" },
      { "level": 13, "size": 13, "minSize": 12, "lineHeight": 20, "minLineHeight": 18, "family": "hei", "weight": 400, "use": "注释、对照卡标签、字格状态、日期" },
      { "level": 11, "size": 11, "minSize": 11, "lineHeight": 16, "minLineHeight": 16, "family": "hei", "weight": 500, "use": "下限：图例、角标" }
    ],
    "glyph": { "faceRatioOfCell": 0.8, "promptCell": 52, "listMin": 28, "compareCardFace": 0.84, "tieCellFace": 0.76, "wallCellFace": 0.8 },
    "pinyin": { "family": "hei", "sizePrompt": 15, "sizeList": 13, "color": "ink2", "minLineHeightRatio": 1.45, "toneHeadroomEm": 0.3, "gapToCell": 4, "position": "只注目标格正上方" },
    "rules": {
      "letterSpacingCJK": 0,
      "letterSpacingVerticalInscription": "0.2em",
      "numerals": "大数字宋 34 + 量词黑 15，间距 4；统计与进度用黑体 tabular-nums；进度「2 / 5」",
      "dates": "界面「10月3日」不打空格；纸面落款用汉字；数量 2 写「两」",
      "mixedScript": "不手打空格；断行禁止间隔号、标点行首",
      "minSize": 11
    },
    "dynamicType": {
      "k": { "xS": 0.82, "S": 0.88, "M": 0.94, "L": 1, "XL": 1.12, "XXL": 1.24, "XXXL": 1.35 },
      "ax": {
        "note": "AX1–AX5 按层级分别取值（D49，实现交接 §0.3 / 减法修稿 §5-1），不再乘 k；每个数组依次是 AX1…AX5 的字号（pt）",
        "t11": [20, 24, 29, 34, 40],
        "t13": [23, 27, 33, 38, 44],
        "t15": [25, 30, 36, 42, 49],
        "t17": [28, 33, 40, 47, 53],
        "t22": [34, 39, 44, 50, 56],
        "t28": [38, 43, 48, 53, 58],
        "t34": [44, 48, 52, 56, 60],
        "lineHeight": "字号 × 1.18 取整到偶数，且不小于该级默认行高；t17 的单行行高与多行同值",
        "buttonHeight": "max(54, lh17 + 26)；AX5 为 88"
      },
      "accessibility": "AX1–AX5 单独排版：按钮纵向堆叠、页头标题可两行；书写格不随字号变（D29）"
    }
  },

  "space": { "scale": [4, 8, 12, 16, 20, 24, 32, 48, 64], "gutter": 20, "groupGap": 32, "promptToGrid": 24, "bottomActionRowTop": "安全区上方：文字行 44 + 间距 6 + 主操作 54" },
  "radius": { "work": 0, "control": 12, "container": 24, "curve": "continuous", "nesting": "inner = outer − inset，小于 0 取 0" },
  "line": { "hairline": 0.5, "frame": 1, "guide": 0.75, "guideDash": [4, 4], "targetCellFrame": 1 },
  "shadow": {
    "light": { "sheet": "0 -0.5 0 rgba(38,33,29,.10), 0 -10 30 rgba(38,33,29,.10)", "preview": "0 2 12 rgba(38,33,29,.06)", "toast": "0 4 16 rgba(38,33,29,.12)" },
    "dark": { "sheet": "0 -0.5 0 rgba(255,240,220,.06)", "preview": "0 2 12 rgba(0,0,0,.28)", "toast": "0 4 16 rgba(0,0,0,.40)" },
    "rule": "只有弹层有阴影；其余层次靠纸的明度差。唯一的例外：分享预览里的那张图（浅纸，放在弹层里比弹层深一档的底上）带一层很轻的 preview 投影与 0.5pt 外缘，像一张放在桌上的纸（第三轮 C3-R，D53 ⑤）。第二个例外：L4 浮条（撤销条、失败提示条、Toast）带一层 toast 轻阴影，和 1pt line 细边一起把浅面托起来（D71 ③）——浮条不许用实心深色，只能靠「浮起」和主按钮分开。"
  },
  "touch": { "minHit": 44, "buttonHeight": 54, "iconButtonVisible": 36 },
  "motion": {
    "rule": "代码里的动画时长、延迟与曲线只能取本节令牌；手势阈值只能取 gesture；非动画的计时只能取 timing。verify:tokens 的 motion 规则强制（交互与动效规范 T2 / §8a，D58）。",
    "pressScale": 0.97, "pressIn": 120, "release": 220, "easeOut": "cubic-bezier(.2,.7,.2,1)",
    "aliasNote": "pressScale / pressIn / release / easeOut 是旧名，保留为 scale.press / duration.press / duration.release / easing.out 的别名一个版本（tokens.css --press-scale / --t-press / --t-release / --ease-out）",
    "duration": { "instant": 0, "xs": 75, "press": 120, "reduce": 150, "fade": 150, "s": 180, "m": 200, "release": 220, "l": 260, "sheet": 280, "push": 300, "paperClose": 360, "paperOpen": 420 },
    "role": {
      "pressIn": "press", "pressOut": "release", "fadeIn": "fade", "fadeOut": "fade", "textOut": "xs", "inkFlip": "m", "phaseReverse": 280,
      "pushIn": "push", "pushOut": "push", "pushGestureMin": "fade", "paperIn": "paperOpen", "paperOut": "paperClose", "paperGestureFull": "push", "paperGestureMin": "press",
      "quietIn": "release", "quietOut": "s", "gestureCancel": "release", "gestureSnap": "m", "sheetIn": "sheet", "sheetOut": "release", "sheetOutKeyboard": "l", "confirmIn": "m", "confirmOut": "s",
      "scrimIn": "m", "scrimOut": "s", "toastIn": "fade", "toastOut": "fade", "hintIn": "fade", "hintStrokeOut": "l", "switchToggle": "fade", "reduceCrossfade": "reduce"
    },
    "moment": { "judgeAppear": 320, "judgeReady": 440, "settleLift": 100, "settleFadeFrom": 380, "settleEnd": 460, "settleCountBox": 14, "settleLiftScale": 0.97, "answerReveal": 400, "workCellIn": 180, "workStagger": 50, "sealDrop": 220, "resultLateIn": 150, "inviteDelay": 600, "handoffHold": 600, "max": 750, "resultMax": 1200, "stepPlayMax": 1600 },
    "easing": { "linear": "linear", "out": "cubic-bezier(.2,.7,.2,1)", "in": "cubic-bezier(.4,0,1,1)", "inout": "cubic-bezier(.4,0,.2,1)", "paperOpen": "cubic-bezier(.3,0,.1,1)", "gather": "cubic-bezier(.5,0,.15,1)" },
    "spring": {
      "standard": { "response": 0.42, "dampingFraction": 0.88, "note": "阶段 2 原生；网页用 easing.out + 同时长近似" },
      "soft": { "response": 0.50, "dampingFraction": 0.82 }
    },
    "scale": { "press": 0.97, "quietFrom": 0.96, "confirmFrom": 0.96, "sealFrom": 1.25 },
    "distance": { "parallax": 0.3, "paperDragLean": 60, "paperDragRadius": 24, "quietDrag": 40, "textShift": 4 },
    "reduceMotion": "所有位移、缩放、模糊、逐笔写出、笔顺快放换成 duration.reduce（150ms）线性交叉淡化，终态逐像素相同；按下缩放保留；触觉与声音照发（D58 ②）。"
  },
  "gesture": { "edgeZoneNative": 20, "edgeZoneWeb": 12, "directionSlop": 10, "commitRatio": 0.3333, "commitVelocity": 500, "returnVelocity": -200, "marginSlope": 0.5, "sheetCommitRatio": 0.3333 },
  "timing": { "pressGuard": 400, "toast": 3200, "toastWithAction": 5000, "undoWindow": 5000, "undone": 2400, "loadingQuiet": 400, "loadingText": 2000, "sourceFresh": 2000, "savedFlash": 1500 },
  "haptic": {
    "note": "交互与动效规范 F1（D58 ③）：五档；原生 WebViewController.swift 的参数由单测逐值核对",
    "judge": { "native": "UIImpactFeedbackGenerator", "style": "soft", "intensity": 0.7 },
    "seal": { "native": "UIImpactFeedbackGenerator", "style": "rigid", "intensity": 0.8 },
    "light": { "native": "UIImpactFeedbackGenerator", "style": "light", "intensity": 0.5 },
    "select": { "native": "UISelectionFeedbackGenerator" },
    "none": {}
  },
  "texture": {
    "where": ["书写格", "对照卡", "结果字帖", "月帖", "分享图", "年报长卷"],
    "never": ["页面底", "按钮", "弹层", "列表"],
    "asset": "扫描宣纸 / 皮纸 1024² 无缝位图，浅深各一；亮度起伏 ≤ 3%；最小特征 ≥ 3pt；禁止规则点阵",
    "placeholderStrength": { "light": { "grain": 0.055 }, "dark": { "grain": 0.035 } }
  },
  "seal": { "style": "白文「字」，方形直角", "sizes": [16, 24, 40], "rotationInWork": -2, "rotationInBrand": 0, "perScreen": 1, "where": ["落款", "品牌（启动、关于、首页题记）"] },
  "components": {
    "writingGrid": { "size": "clamp(258, min(screenWidth − 40, availableHeight), 400)", "internalUnits": 345, "toolsRow": { "height": 40, "position": "格子下沿外侧，右对齐" } },
    "compareCard": { "width": "(contentWidth − 12) / 2", "gap": 12 },
    "wrongDot": { "diameter": "clamp(5, cellWidth × 0.07, 8)", "offset": "墨迹外框右上外 2pt" },
    "wall": { "columns": 8, "columnsProMax": 9, "tiers": [1, 0.82, 0.68, 0.55] },
    "toast": { "minHeight": 48, "undoSeconds": 5, "timerLine": 2, "timerColor": "ink3", "timerOpacity": 0.4, "radius": "container", "border": 1, "surface": "elev", "rule": "实心深色填充只给每屏唯一的主按钮；浮条是浮起的浅面（elev + 1pt line + shadow.toast），正文 ink1，操作是文字按钮（toastAct，500 字重，无下划线），圆角取 container（24：最小高 48 时正好是胶囊），与主 / 次按钮（12 圆角、满宽实心或描边）在形状和颜色上都分开（D71 ③，Apple HIG：一屏一个突出按钮）" },
    "primaryButtonWidth": { "flowPages": "满宽（内容宽）", "home": 240 }
  },

  "mapping": {
    "--k": { "to": "typography.dynamicType.k", "note": "由系统字号连续映射；data-large 的 1.3 值废止（D29）" },
    "--hint": { "to": "color.danzhu", "note": "提示改淡朱实心笔画，不再等于文字红（D34）" },
    "--lamp": { "to": null, "note": "暖灯取消（V08：真机不可见）" },
    "--p": { "to": "color.paper" },
    "--c": { "to": "color.sheet", "note": "浮纸 → 笺；卡片取消，只用于书写格 / 对照卡 / 字帖；次按钮不再用它做底" },
    "--sh": { "to": "color.elev" },
    "--off": { "to": "color.field" },
    "--i1": { "to": "color.ink1" },
    "--i2": { "to": "color.ink2" },
    "--i3": { "to": "color.ink3" },
    "--i4": { "to": "color.ink4", "note": "「提示框内已写过的笔画」这一用途废止：提示时本人墨不变暗" },
    "--i5": { "to": "color.line" },
    "--a": { "to": "color.btnBg", "note": "主按钮由朱改墨；配字由白改 btnFg（纸色）" },
    "--ar": { "to": ["color.zhu", "color.danzhu", "color.ink1"], "note": "拆分：红点 / 写错 → zhu；提示笔画 → danzhu；强调字、今天、选中 → ink1" },
    "--g": { "to": ["color.frame", "color.guide"], "note": "田字格线由 28% 朱改为印刷赭灰：外框 frame，十字 guide" },
    "--st1": { "to": null, "note": "未引用，删除" },
    "--st2": { "to": null, "note": "未引用，删除" },
    "--scrim": { "to": "color.scrim" },
    "--hi": { "to": null, "note": "仿系统 Home 指示条，由系统提供" },
    "--ref": { "to": "color.ref" },
    "--tf": { "to": "color.danzhu", "note": "描一遍改为逐笔引导：当前笔淡朱实心" },
    "--tl": { "to": "color.danzhu", "note": "未到的笔用淡朱双钩；灰轮廓废止" },
    "--o": { "to": "color.danzhu" },
    "--ln": { "to": "color.line" },
    "--seal": { "to": "color.seal" },
    "--tt": { "to": "color.ink1", "note": "首页标题由灰改墨一（V06 层级倒置）" },
    "--tb": { "to": "color.ink2" },
    "--tm": { "to": "color.ink3" },
    "--tn": { "to": ["color.ink3", "color.ink1"], "note": "未选 ink3，选中 ink1（不再是朱）" },
    "--btn": { "to": "color.btnBg", "note": "首页「拾」朱块取消，改墨色主按钮" },
    "--down": { "to": "color.btnDown" },
    "--ho": { "to": null, "note": "未引用，删除" },
    "--sy0": { "to": null, "note": "系统面板示意色，产品不引用" },
    "--syt": { "to": null },
    "--sys": { "to": null },
    "--syl": { "to": null },
    "--paper-image": { "to": "texture", "note": "只用于笺面（.tex），页面底不再有点阵纸纹；深色暖灯取消" },
    "--paper-size": { "to": "texture" },
    "--paper-position": { "to": "texture" },
    "--paper-repeat": { "to": "texture" },
    "(new)": { "to": ["color.hand", "color.under", "color.wall1-4", "color.onSeal", "color.btnFg", "color.toastBg", "color.toastFg", "color.frame", "color.guide", "color.danzhu"], "note": "新增令牌，工程需新建 CSS 变量；建议命名与 shizi.css 一致（--hand --under --wall1 …）" }
  }
}
