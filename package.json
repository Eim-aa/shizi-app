{
  "name": "shizi-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "start": "python3 -m http.server 8000 --bind 127.0.0.1",
    "build:credits": "node scripts/build_credits.mjs",
    "build:manifest": "node scripts/build_shell_manifest.mjs",
    "build:order": "node scripts/build_char_order.mjs",
    "verify:governance": "python3 scripts/verify_library_governance.py",
    "verify:vector440": "node scripts/verify_vector_data_440.js",
    "verify:content": "node scripts/verify_content_corpus.cjs",
    "verify:assets": "node scripts/verify_assets.mjs",
    "verify:sw-unit": "node scripts/verify_sw_unit.mjs",
    "verify:api": "node scripts/verify_api_floor.mjs",
    "verify:order": "node scripts/build_char_order.mjs --check",
    "verify:data": "pnpm run verify:governance && pnpm run verify:vector440 && pnpm run verify:content && pnpm run verify:assets && pnpm run verify:sw-unit && pnpm run verify:api && pnpm run verify:order",
    "verify:unit": "node --test \"test/**/*.test.mjs\"",
    "verify:copy": "node scripts/verify_copy.mjs",
    "verify:tokens": "node scripts/verify_tokens.mjs",
    "verify:pwa": "node scripts/verify_pwa_upgrade.js",
    "verify:web": "node scripts/e2e/run.mjs && node scripts/verify_pwa_upgrade.js",
    "verify:native-ui": "bash ios/ShiziApp/scripts/verify-native-ui.sh",
    "verify:core-diff": "node scripts/core-diff/verify.mjs",
    "test": "pnpm run verify:data && pnpm run verify:unit && pnpm run verify:copy && pnpm run verify:tokens && pnpm run verify:web"
  },
  "devDependencies": {
    "playwright": "1.62.0"
  }
}
