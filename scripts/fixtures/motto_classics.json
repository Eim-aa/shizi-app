  "entries": [
    { "text": "翰不虚动，下必有由", "author": "孙过庭", "source": "书谱" },
    { "text": "心不厌精，手不忘熟", "author": "孙过庭", "source": "书谱" },
    { "text": "初学分布，但求平正", "author": "孙过庭", "source": "书谱" },
    { "text": "既知平正，务追险绝", "author": "孙过庭", "source": "书谱" },
    { "text": "既能险绝，复归平正", "author": "孙过庭", "source": "书谱" },
    { "text": "察之者尚精，拟之者贵似", "author": "孙过庭", "source": "书谱" },
    { "text": "一点成一字之规", "author": "孙过庭", "source": "书谱" },
    { "text": "一字乃终篇之准", "author": "孙过庭", "source": "书谱" },
    { "text": "思虑通审，志气和平", "author": "孙过庭", "source": "书谱" },
    { "text": "不激不厉，而风规自远", "author": "孙过庭", "source": "书谱" },
    { "text": "导之则泉注，顿之则山安", "author": "孙过庭", "source": "书谱" },
    { "text": "得时不如得器", "author": "孙过庭", "source": "书谱" },
    { "text": "得器不如得志", "author": "孙过庭", "source": "书谱" },
    { "text": "真以点画为形质", "author": "孙过庭", "source": "书谱" },
    { "text": "草以使转为形质", "author": "孙过庭", "source": "书谱" },
    { "text": "篆尚婉而通", "author": "孙过庭", "source": "书谱" },
    { "text": "隶欲精而密", "author": "孙过庭", "source": "书谱" },
    { "text": "草贵流而畅", "author": "孙过庭", "source": "书谱" },
    { "text": "章务险而便", "author": "孙过庭", "source": "书谱" },
    { "text": "纸墨相发", "author": "孙过庭", "source": "书谱" },
    { "text": "神融笔畅", "author": "孙过庭", "source": "书谱" },
    { "text": "意先笔后，潇洒流落", "author": "孙过庭", "source": "书谱" },
    { "text": "书者，散也", "author": "蔡邕", "source": "笔论" },
    { "text": "欲书，先散怀抱", "author": "蔡邕", "source": "笔论" },
    { "text": "任情恣性，然后书之", "author": "蔡邕", "source": "笔论" },
    { "text": "夫书，先默坐静思", "author": "蔡邕", "source": "笔论" },
    { "text": "随意所适", "author": "蔡邕", "source": "笔论" },
    { "text": "言不出口，气不盈息", "author": "蔡邕", "source": "笔论" },
    { "text": "沈密神彩，如对至尊", "author": "蔡邕", "source": "笔论" },
    { "text": "玉不琢，不成器", "author": "", "source": "礼记·学记" },
    { "text": "人不学，不知道", "author": "", "source": "礼记·学记" },
    { "text": "教学为先", "author": "", "source": "礼记·学记" },
    { "text": "学然后知不足", "author": "", "source": "礼记·学记" },
    { "text": "教然后知困", "author": "", "source": "礼记·学记" },
    { "text": "知不足，然后能自反", "author": "", "source": "礼记·学记" },
    { "text": "知困，然后能自强", "author": "", "source": "礼记·学记" },
    { "text": "教学相长", "author": "", "source": "礼记·学记" },
    { "text": "敬业乐群", "author": "", "source": "礼记·学记" },
    { "text": "博习亲师", "author": "", "source": "礼记·学记" },
    { "text": "学不躐等", "author": "", "source": "礼记·学记" },
    { "text": "业精于勤，荒于嬉", "author": "韩愈", "source": "进学解" },
    { "text": "行成于思，毁于随", "author": "韩愈", "source": "进学解" },
    { "text": "口不绝吟于六艺之文", "author": "韩愈", "source": "进学解" },
    { "text": "手不停披于百家之编", "author": "韩愈", "source": "进学解" },
    { "text": "学而时习之，不亦说乎", "author": "孔子", "source": "论语·学而" },
    { "text": "传不习乎", "author": "曾子", "source": "论语·学而" },
    { "text": "行有余力，则以学文", "author": "孔子", "source": "论语·学而" },
    { "text": "学则不固", "author": "孔子", "source": "论语·学而" },
    { "text": "过则勿惮改", "author": "孔子", "source": "论语·学而" },
    { "text": "敏于事而慎于言", "author": "孔子", "source": "论语·学而" },
    { "text": "如切如磋，如琢如磨", "author": "", "source": "诗经·卫风·淇奥" },
    { "text": "作字要熟，熟则神气完实", "author": "欧阳修", "source": "试笔" }
  ]
}
